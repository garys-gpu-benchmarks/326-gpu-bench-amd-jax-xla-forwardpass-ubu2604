  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --dtype FP16 --sequence-len 16 --hidden-size 64 --num-layers 1 --num-heads 4 --batch-size 1 --warmup-iters 1 --num-iterations 3 --seed 42 --vocab-size 32000"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --dtype BF16 --sequence-len 128 --hidden-size 512 --num-layers 4 --num-heads 8 --batch-size 8 --warmup-iters 3 --num-iterations 2630000 --seed 42 --vocab-size 32000"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --device-id 0 --dtype FP32 --sequence-len 128 --hidden-size 512 --num-layers 4 --num-heads 8 --batch-size 8 --warmup-iters 5 --num-iterations 7180000 --seed 42 --vocab-size 32000"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "forward_latency_msec, tokens_per_sec, tflops, jit_compile_msec, peak_hbm_gb"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "status=ok and every metric is a finite number; peak_hbm_gb may instead be na (peak memory not reported)"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "tokens_per_sec = batch_size x sequence_len / forward-pass time. tflops counts every matmul: per layer 8bsh^2 (Q/K/V/O) + 4bs^2h (attention) + 8bsh^2 (MLP), plus 2bsh x vocab for the output projection. peak_hbm_gb is JAX peak_bytes_in_use, else used VRAM from nvidia-smi or rocm-smi, else na (peak memory not reported)"
  },
